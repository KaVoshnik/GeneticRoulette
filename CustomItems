    // Все загрузки предметов из Resources по id идут через этот метод.
    [HarmonyPatch(typeof(Resources), "Load", new Type[] { typeof(string), typeof(Type) })]
    static class Patch_ResourcesLoadTyped
    {
        static bool Prefix(string path, Type systemTypeInstance, ref UnityEngine.Object __result)
        {
            if (!CustomItems.IsCustom(path)) return true;
            GameObject p = CustomItems.GetPrefab(path);
            if (p == null) return true;
            if (systemTypeInstance != null && !systemTypeInstance.IsAssignableFrom(typeof(GameObject))) return true;
            __result = p;
            return false;
        }
    }

