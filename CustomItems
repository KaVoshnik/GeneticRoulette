        static bool spriteSearchLogged;

        /// <summary>Ищет PNG: рядом с DLL, в Sprites рядом с DLL, в plugins/GeneticRoulette/Sprites и рекурсивно по plugins (без учёта регистра).</summary>
        static string FindSpriteFile(string fileName)
        {
            List<string> tried = new List<string>();
            try
            {
                string loc = Plugin.Instance != null ? Plugin.Instance.Info.Location : null;
                string dllDir = string.IsNullOrEmpty(loc) ? null : Path.GetDirectoryName(loc);
                string pluginsDir = BepInEx.Paths.PluginPath;

                List<string> cand = new List<string>();
                if (dllDir != null)
                {
                    cand.Add(Path.Combine(Path.Combine(dllDir, "Sprites"), fileName));
                    cand.Add(Path.Combine(dllDir, fileName));
                }
                cand.Add(Path.Combine(Path.Combine(Path.Combine(pluginsDir, "GeneticRoulette"), "Sprites"), fileName));
                cand.Add(Path.Combine(Path.Combine(pluginsDir, "Sprites"), fileName));
                cand.Add(Path.Combine(pluginsDir, fileName));

                foreach (string p in cand)
                {
                    tried.Add(p);
                    if (File.Exists(p)) return p;
                }

                // последний шанс: любая папка внутри plugins, регистр не важен
                if (Directory.Exists(pluginsDir))
                {
                    foreach (string f in Directory.GetFiles(pluginsDir, "*.png", SearchOption.AllDirectories))
                        if (string.Equals(Path.GetFileName(f), fileName, StringComparison.OrdinalIgnoreCase)) return f;
                }
            }
            catch (Exception e) { Plugin.Log.LogWarning("Поиск спрайта " + fileName + ": " + e.Message); }

            if (!spriteSearchLogged)
            {
                spriteSearchLogged = true;
                Plugin.Log.LogWarning("Файл спрайта '" + fileName + "' не найден. Искал: " + string.Join(" | ", tried.ToArray())
                    + ". Положите его, например, сюда: " + (tried.Count > 0 ? tried[0] : "BepInEx/plugins/GeneticRoulette/Sprites/" + fileName));
            }
            return null;
        }

        static Sprite MakeSprite(byte[] png, string id)
        {
            Texture2D tex = new Texture2D(2, 2, TextureFormat.RGBA32, false);
            if (!ImageConversion.LoadImage(tex, png)) return null;
            tex.filterMode = FilterMode.Point;
            tex.wrapMode = TextureWrapMode.Clamp;
            tex.name = id;
            // в игре 8 пикселей на единицу, центр спрайта в середине
            Sprite sp = Sprite.Create(tex, new Rect(0, 0, tex.width, tex.height), new Vector2(0.5f, 0.5f), 8f);
            sp.name = id;
            return sp;
        }

        static Sprite LoadSprite(CustomItemDef d)
        {
            Sprite sp;
            if (string.IsNullOrEmpty(d.SpriteFile)) return null;      // своего спрайта у предмета нет
            if (sprites.TryGetValue(d.Id, out sp) && sp != null) return sp;

            // 1) файл пользователя
            try
            {
                string path = FindSpriteFile(d.SpriteFile);
                if (path != null)
                {
                    sp = MakeSprite(File.ReadAllBytes(path), d.Id);
                    if (sp != null)
                    {
                        Plugin.Log.LogInfo("Спрайт " + d.Id + ": файл " + path + " (" + sp.texture.width + "x" + sp.texture.height + ")");
                        sprites[d.Id] = sp;
                        return sp;
                    }
                    Plugin.Log.LogWarning("Не удалось прочитать PNG " + path + ", использую встроенный спрайт");
                }
            }
            catch (Exception e) { Plugin.Log.LogWarning("Спрайт " + d.SpriteFile + ": " + e.Message); }

            // 2) встроенная заготовка
            try
            {
                string b64;
                if (EmbeddedSprites.TryGetValue(d.Id, out b64))
                {
                    sp = MakeSprite(Convert.FromBase64String(b64), d.Id);
                    if (sp != null)
                    {
                        Plugin.Log.LogInfo("Спрайт " + d.Id + ": встроенная заготовка (файл " + d.SpriteFile + " не найден)");
                        sprites[d.Id] = sp;
                        return sp;
                    }
                }
            }
            catch (Exception e) { Plugin.Log.LogWarning("Встроенный спрайт " + d.Id + ": " + e.Message); }
            return null;
        }

        /// <summary>Возвращает префаб предмета мода (создаёт копию префаба-шаблона при первом запросе).</summary>
        internal static GameObject GetPrefab(string id)
        {
            GameObject p;
            if (prefabs.TryGetValue(id, out p) && p != null) return p;
            CustomItemDef d = Find(id);
            if (d == null || inGetPrefab) return null;

            inGetPrefab = true;
            try
            {
                GameObject tpl = Resources.Load(d.Template) as GameObject;
                if (tpl == null) { Plugin.Problem("Нет префаба-шаблона '" + d.Template + "' для " + id); return null; }

                if (holder == null)
                {
                    holder = new GameObject("GeneticRoulette_Prefabs");
                    holder.SetActive(false);                       // всё внутри не просыпается (Awake не вызывается)
                    holder.hideFlags = HideFlags.HideAndDontSave;
                    UnityEngine.Object.DontDestroyOnLoad(holder);
                }

                GameObject clone = UnityEngine.Object.Instantiate(tpl, holder.transform);
                clone.name = id;

                Item it = clone.GetComponent<Item>();
                FieldInfo idField = typeof(Item).GetField("id", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
                if (it == null || idField == null)
                {
                    Plugin.Problem("У префаба '" + d.Template + "' нет Item.id: предмет " + id + " не создан");
                    UnityEngine.Object.Destroy(clone);
                    return null;
                }
                idField.SetValue(it, id);

                SpriteRenderer sr = clone.GetComponent<SpriteRenderer>();
                Sprite custom = LoadSprite(d);
                if (sr != null)
                {
                    if (custom != null)
                    {
                        sr.sprite = custom;
                        BoxCollider2D bc = clone.GetComponent<BoxCollider2D>();
                        if (bc != null) bc.size = custom.bounds.size;
                        CircleCollider2D cc = clone.GetComponent<CircleCollider2D>();
                        if (cc != null) cc.radius = Mathf.Max(custom.bounds.size.x, custom.bounds.size.y) * 0.5f;
                    }
                    else if (d.Tint != Color.white)
                    {
                        sr.color = d.Tint;      // запасной вариант: спрайт шаблона, подкрашенный
                    }
                }

                prefabs[id] = clone;
                return clone;
            }
            catch (Exception e)
            {
                Plugin.Problem("Не удалось создать префаб " + id + ": " + e.Message);
                Plugin.Log.LogError(e);
                return null;
            }
            finally { inGetPrefab = false; }
        }

        // =====================================================================
        // Стартовый набор
        // =====================================================================
        internal static void GiveStarterKit(Body b)
        {
            if (!Plugin.CfgStarterKit.Value || b == null) return;
            try
            {
                int n = 0;
                foreach (CustomItemDef d in Items_)
                {
                    if (!Plugin.Has(d.StarterFor)) continue;
                    Vector2 pos = (Vector2)b.transform.position + new Vector2(0.6f * (n + 1), 0.8f);
                    GameObject go = Utils.Create(d.Id, pos, 0f);
                    if (go == null) Plugin.Log.LogWarning("Стартовый набор: не удалось создать " + d.Id);
                    n++;
                }
            }
            catch (Exception e) { Plugin.Log.LogWarning("Стартовый набор: " + e.Message); }
        }
    }

