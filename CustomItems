        internal static bool IsCustom(string id)
        {
            if (string.IsNullOrEmpty(id)) return false;
            foreach (CustomItemDef d in Items_) if (d.Id == id) return true;
            return false;
        }

        static CustomItemDef Find(string id)
        {
            foreach (CustomItemDef d in Items_) if (d.Id == id) return d;
            return null;
        }

        // =====================================================================
        // Регистрация (вызывается после Item.SetupItems; SetupItems пересоздаёт GlobalItems при каждой загрузке мира)
        // =====================================================================
        internal static void Register()
        {
            try
            {
                if (Item.GlobalItems == null) return;
                RegisterLiquids();
                WrapSugaryLiquids();
                RegisterItems();
                InjectLocale();
                if (Plugin.CfgItemsInLoot.Value) RebuildLootPool();
            }
            catch (Exception e)
            {
                Plugin.Problem("Не удалось зарегистрировать лекарства: " + e.Message);
                Plugin.Log.LogError(e);
            }
        }

        static void CopyFields(object from, object to)
        {
            if (from == null || to == null) return;
            Type t = from.GetType();
            while (t != null && t != typeof(object))
            {
                foreach (FieldInfo f in t.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly))
                {
                    if (f.IsStatic || f.IsInitOnly) continue;
                    if (!f.DeclaringType.IsAssignableFrom(to.GetType())) continue;
                    try { f.SetValue(to, f.GetValue(from)); } catch (Exception) { }
                }
                t = t.BaseType;
            }
        }

        static void RegisterLiquids()
        {
            if (Liquids.Registry == null) return;
            foreach (CustomLiquidDef d in Liquids_)
            {
                if (Liquids.Registry.ContainsKey(d.Id)) continue;
                LiquidType lt = new LiquidType();
                LiquidType tpl;
                if (Liquids.Registry.TryGetValue(d.TemplateLiquid, out tpl)) CopyFields(tpl, lt);

                lt.localeName = d.Id;
                lt.color = d.Color;
                lt.valuePerLiter = d.ValuePerLiter;
                lt.injectionSickness = d.InjectionSickness;
                lt.injectable = d.Injectable;
                lt.onDrink = d.OnDrink;
                lt.onHealthUse = d.OnHealthUse;

                // у шаблона могли быть «качества» для крафта; свои не нужны
                FieldInfo q = typeof(LiquidType).GetField("qualities");
                if (q != null) { try { q.SetValue(lt, Activator.CreateInstance(q.FieldType)); } catch (Exception) { } }

                Liquids.Registry[d.Id] = lt;
            }
        }

        static void WrapSugaryLiquids()
        {
            if (sugarWrapped || Liquids.Registry == null) return;
            sugarWrapped = true;
            foreach (string id in SugaryLiquids)
            {
                LiquidType lt;
                if (!Liquids.Registry.TryGetValue(id, out lt) || lt == null) continue;
                LiquidType.OnDrink orig = lt.onDrink;
                lt.onDrink = (amount, body) =>
                {
                    if (orig != null) orig(amount, body);
                    Diseases.OnSugaryDrink(body, amount);
                };
            }
        }

        static void RegisterItems()
        {
            foreach (CustomItemDef d in Items_)
            {
                ItemInfo tpl;
                if (!Item.GlobalItems.TryGetValue(d.Template, out tpl) || tpl == null)
                {
                    Plugin.Problem("Нет шаблона предмета '" + d.Template + "' для " + d.Id);
                    continue;
                }

                LiquidItemInfo li = new LiquidItemInfo();
                CopyFields(tpl, li);

                bool ru = Plugin.Ru();
                li.fullName = ru ? d.NameRu : d.NameEn;
                li.description = ru ? d.DescRu : d.DescEn;
                li.capacity = d.Capacity;
                li.weight = d.Weight;
                li.value = d.Value;
                li.autoFill = false;
                li.defaultContents = new List<LiquidStack> { new LiquidStack(d.LiquidId, d.Contents) };
                li.rec = new Recognition(1);

                if (d.OralUse)
                {
                    // как таблетки: за одно применение выпивается 10 мл
                    li.useAction = (body, item) =>
                    {
                        WaterContainerItem w = item != null ? item.GetComponent<WaterContainerItem>() : null;
                        if (w != null) w.Drink(body, 10f, "spray");
                    };
                }

                Item.GlobalItems[d.Id] = li;
            }
        }

        static void RebuildLootPool()
        {
            try
            {
                MethodInfo mi = AccessTools.Method(typeof(ItemLootPool), "InitializePool");
                if (mi != null) mi.Invoke(null, null);
            }
            catch (Exception e) { Plugin.Log.LogWarning("Не удалось обновить пул добычи: " + e.Message); }
        }

        // =====================================================================
