            GameObject p = CustomItems.GetPrefab(path);
            if (p == null) return true;
            __result = p;
            return false;
        }
    }

    // Запасной слой: Utils.Create (так игра создаёт предметы по id). На случай, если Resources.Load
    // будет «вшит» JIT-компилятором в вызывающий код и патч выше не сработает.
    [HarmonyPatch(typeof(Utils), "Create", new Type[] { typeof(string), typeof(Vector2), typeof(float) })]
    static class Patch_UtilsCreatePos
    {
        static bool Prefix(string __0, Vector2 __1, float __2, ref GameObject __result)
        {
            if (!CustomItems.IsCustom(__0)) return true;
            GameObject p = CustomItems.GetPrefab(__0);
            if (p == null) return true;
