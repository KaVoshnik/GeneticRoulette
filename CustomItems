        // =====================================================================
        internal static void InjectLocale()
        {
            try
            {
                Language lang = Locale.currentLang;
                if (lang == null) return;
                bool ru = Plugin.Ru();
                foreach (CustomLiquidDef d in Liquids_)
                {
                    SetStr(lang.other, d.Id, ru ? d.NameRu : d.NameEn);
                    SetStr(lang.other, d.Id + "dsc", ru ? d.DescRu : d.DescEn);
                }
                foreach (CustomItemDef d in Items_)
                {
                    SetStr(lang.main, d.Id, ru ? d.NameRu : d.NameEn);
                    SetStr(lang.main, d.Id + "dsc", ru ? d.DescRu : d.DescEn);
                }
            }
            catch (Exception e) { Plugin.Log.LogWarning("Locale inject failed: " + e.Message); }
        }

        static void SetStr(Dictionary<string, string> dict, string key, string value)
        {
            if (dict != null) dict[key] = value;
